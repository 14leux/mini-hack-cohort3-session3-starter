    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "mcp": "^1.4.2",
    "ollama": "^0.6.3",
    "openai": "^7.4.0"
  }
}
